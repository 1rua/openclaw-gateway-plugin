{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-android-intelligence.dev/schemas/gateway/v2/event.schema.json",
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correlationId", "occurredAt", "payload"],
      "properties": {
        "correlationId": {
          "$ref": "https://open-android-intelligence.dev/schemas/gateway/v2/envelope.schema.json#/$defs/opaqueId"
        },
        "occurredAt": {
          "$ref": "https://open-android-intelligence.dev/schemas/gateway/v2/envelope.schema.json#/$defs/utcMillis"
        },
        "type": {
          "$comment": "Event type is carried by the validated SSE event line (contract §9); this mirror is optional and lists the V2 event types.",
          "type": "string",
          "enum": [
            "conversation.message.delta",
            "conversation.message.completed",
            "conversation.message.status",
            "conversation.command.result",
            "conversation.approval.requested",
            "conversation.approval.resolved",
            "conversation.title.updated",
            "device.requested",
            "device.request.cancel.requested",
            "pairing.grant.changed",
            "session.revoked",
            "attachment.acknowledged",
            "gateway.notice"
          ]
        },
        "payload": {
          "$comment": "Dispatch by the validated SSE event type (the dispatch key is the eventType string in dispatched-schema-fixtures.json, NOT a $defs key) and validate again with its event-specific sub-Schema; missing sub-Schema must fail closed. Normative copies of the payload shapes live in $defs.sessionRevokedPayload and $defs.pairingGrantChangedPayload.",
          "type": "object"
        }
      }
    },
    "sessionRevokedPayload": {
      "$comment": "Normative copy for eventType 'session.revoked' (contract §9). Notification only.",
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId"],
      "properties": {
        "sessionId": {
          "$ref": "https://open-android-intelligence.dev/schemas/gateway/v2/envelope.schema.json#/$defs/opaqueId"
        },
        "deviceId": {
          "$ref": "https://open-android-intelligence.dev/schemas/gateway/v2/envelope.schema.json#/$defs/opaqueId"
        }
      }
    },
    "pairingGrantChangedPayload": {
      "$comment": "Normative copy for eventType 'pairing.grant.changed' (contract §9/§11). Notification only: the event must never widen the Android-local authoritative grant record; decisions still travel the request path and stale revisions still return GRANT_STALE.",
      "type": "object",
      "additionalProperties": false,
      "required": ["grantRevision"],
      "properties": {
        "grantRevision": { "type": "integer", "minimum": 0 },
        "deviceId": {
          "$comment": "All newly emitted notifications identify the affected device. Optional only for replay of persisted pre-upgrade events.",
          "$ref": "https://open-android-intelligence.dev/schemas/gateway/v2/envelope.schema.json#/$defs/opaqueId"
        },
        "pluginId": { "type": "string", "minLength": 1 },
        "authorKeyId": {
          "$ref": "https://open-android-intelligence.dev/schemas/gateway/v2/envelope.schema.json#/$defs/prefixedSha256"
        },
        "capabilityId": { "type": "string", "minLength": 1 },
        "capabilityVersion": { "type": "string", "minLength": 1 },
        "grantDigest": {
          "$ref": "https://open-android-intelligence.dev/schemas/gateway/v2/envelope.schema.json#/$defs/prefixedSha256"
        }
      }
    },
    "conversationMessagePayload": {
      "$comment": "Shared shape for eventType 'conversation.message.delta' and 'conversation.message.completed' (contract §9). text carries the accumulated message body (upsert semantics), not a fragment. parts is a closed list of text parts; an empty text is legal.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conversationId",
        "messageId",
        "sender",
        "parts",
        "text",
        "timestamp",
        "revision"
      ],
      "properties": {
        "conversationId": {
          "$ref": "https://open-android-intelligence.dev/schemas/gateway/v2/envelope.schema.json#/$defs/opaqueId"
        },
        "messageId": {
          "$ref": "https://open-android-intelligence.dev/schemas/gateway/v2/envelope.schema.json#/$defs/opaqueId"
        },
        "sender": { "type": "string", "minLength": 1 },
        "parts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "text"],
            "properties": {
              "type": { "const": "text" },
              "text": { "type": "string" }
            }
          }
        },
        "text": { "type": "string" },
        "timestamp": { "type": "integer", "minimum": 0 },
        "revision": { "type": "integer", "minimum": 0 }
      }
    },
    "messageDeltaPayload": {
      "$comment": "Normative copy for eventType 'conversation.message.delta'.",
      "$ref": "#/$defs/conversationMessagePayload"
    },
    "messageCompletedPayload": {
      "$comment": "Normative copy for eventType 'conversation.message.completed'.",
      "$ref": "#/$defs/conversationMessagePayload"
    },
    "messageStatusPayload": {
      "$comment": "Normative copy for eventType 'conversation.message.status'. Status changes are monotonic per message revision; failed contains a stable errorCode without provider secrets.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "conversationId": {},
        "messageId": {},
        "clientMessageId": {},
        "status": {},
        "revision": {},
        "errorCode": {}
      },
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["conversationId", "messageId", "clientMessageId", "status", "revision", "errorCode"],
          "properties": {
            "conversationId": { "$ref": "https://open-android-intelligence.dev/schemas/gateway/v2/envelope.schema.json#/$defs/opaqueId" },
            "messageId": { "$ref": "https://open-android-intelligence.dev/schemas/gateway/v2/envelope.schema.json#/$defs/opaqueId" },
            "clientMessageId": { "$ref": "https://open-android-intelligence.dev/schemas/gateway/v2/envelope.schema.json#/$defs/opaqueId" },
            "status": { "const": "failed" },
            "revision": { "type": "integer", "minimum": 0 },
            "errorCode": { "enum": ["AGENT_UNAVAILABLE", "ATTACHMENT_READ_FAILED", "AGENT_MEDIA_REJECTED", "MODEL_REQUEST_REJECTED"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["conversationId", "messageId", "clientMessageId", "status", "revision", "errorCode"],
          "properties": {
            "conversationId": { "$ref": "https://open-android-intelligence.dev/schemas/gateway/v2/envelope.schema.json#/$defs/opaqueId" },
            "messageId": { "$ref": "https://open-android-intelligence.dev/schemas/gateway/v2/envelope.schema.json#/$defs/opaqueId" },
            "clientMessageId": { "$ref": "https://open-android-intelligence.dev/schemas/gateway/v2/envelope.schema.json#/$defs/opaqueId" },
            "status": { "enum": ["queued", "delivered", "completed"] },
            "revision": { "type": "integer", "minimum": 0 },
            "errorCode": { "type": "null" }
          }
        }
      ]
    },
    "titleUpdatedPayload": {
      "$comment": "Normative copy for eventType 'conversation.title.updated'. newTitle mirrors title; an empty title is legal (title clearing).",
      "type": "object",
      "additionalProperties": false,
      "required": ["conversationId", "title", "newTitle"],
      "properties": {
        "conversationId": {
          "$ref": "https://open-android-intelligence.dev/schemas/gateway/v2/envelope.schema.json#/$defs/opaqueId"
        },
        "title": { "type": "string" },
        "newTitle": { "type": "string" }
      }
    },
    "deviceRequestedEventPayload": {
      "$comment": "Normative copy for eventType 'device.requested' (contract §9). Both hosts emit this event, but they currently disagree on width: Hermes mirrors the full request (device-request.schema.json#/$defs/request) while OpenClaw emits { requestId, risk, grantRevision }. Required is therefore the intersection; the remaining request fields are optional. parameters stays an open object because capability sub-schemas dispatch by id/version.",
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "risk", "grantRevision"],
      "properties": {
        "requestId": {
          "$ref": "https://open-android-intelligence.dev/schemas/gateway/v2/envelope.schema.json#/$defs/opaqueId"
        },
        "capability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pluginId", "authorKeyId"],
          "properties": {
            "pluginId": { "type": "string", "minLength": 1 },
            "authorKeyId": {
              "$ref": "https://open-android-intelligence.dev/schemas/gateway/v2/envelope.schema.json#/$defs/prefixedSha256"
            }
          }
        },
        "parameters": {
          "$comment": "Dispatch by the negotiated capability id and version; missing capability sub-Schema must fail closed.",
          "type": "object"
        },
        "risk": {
          "enum": ["read", "sync", "write", "high-privilege-ephemeral"]
        },
        "grantRevision": { "type": "integer", "minimum": 0 },
        "createdAt": {
          "$ref": "https://open-android-intelligence.dev/schemas/gateway/v2/envelope.schema.json#/$defs/utcMillis"
        },
        "expiresAt": {
          "$ref": "https://open-android-intelligence.dev/schemas/gateway/v2/envelope.schema.json#/$defs/utcMillis"
        },
        "requiresForegroundConfirmation": { "type": "boolean" }
      }
    },
    "deviceRequestCancelRequestedPayload": {
      "$comment": "Normative copy for eventType 'device.request.cancel.requested' (contract §9).",
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId"],
      "properties": {
        "requestId": {
          "$ref": "https://open-android-intelligence.dev/schemas/gateway/v2/envelope.schema.json#/$defs/opaqueId"
        }
      }
    },
    "attachmentAcknowledgedPayload": {
      "$comment": "Normative copy for eventType 'attachment.acknowledged' (contract §9).",
      "type": "object",
      "additionalProperties": false,
      "required": ["attachmentId"],
      "properties": {
        "attachmentId": {
          "$ref": "https://open-android-intelligence.dev/schemas/gateway/v2/envelope.schema.json#/$defs/opaqueId"
        }
      }
    }
  }
}
