{
  "name": "@open-android-intelligence/openclaw",
  "version": "1.0.0",
  "description": "Open Android Intelligence Gateway plugin for OpenClaw",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "packageManager": "npm@11.16.0",
  "files": [
    "adapter.ts",
    "src/",
    "gateway-contract/",
    "runtime/",
    "openclaw.plugin.json",
    "plugin-manifest.json",
    "openclaw-plugin-sdk.d.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "build": "tsc -p tsconfig.build.json",
    "contract:check": "python3 tools/check-contract-snapshot.py",
    "plugin:install-smoke": "npm run build && openclaw plugins install ./ --force",
    "plugin:inspect-smoke": "openclaw plugins inspect open-android-intelligence-gateway --runtime --json | node tools/assert-openclaw-runtime.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "canonicalize": "3.0.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "openclaw": "2026.7.1-2",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "openclaw": "2026.7.1-2"
  },
  "openclaw": {
    "extensions": ["./adapter.ts"],
    "runtimeExtensions": ["./runtime/adapter.js"],
    "compat": {
      "pluginApi": "2026.7.1",
      "minGatewayVersion": "2026.7.1"
    },
    "build": {
      "openclawVersion": "2026.7.1-2",
      "pluginSdkVersion": "2026.7.1-2"
    },
    "channel": {
      "id": "open-android-intelligence-gateway",
      "label": "Open Android Intelligence Gateway",
      "blurb": "Open Android Intelligence Gateway Protocol v2"
    }
  }
}
